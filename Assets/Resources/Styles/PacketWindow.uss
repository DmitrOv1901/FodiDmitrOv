.packet-window-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-scrim);
}

.packet-window-frame {
    max-width: 96%;
    max-height: 96%;
    min-width: 0;
    min-height: 0;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    overflow: hidden;
}

.packet-window-content {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.packet-window-body-layout {
    width: 100%;
    height: 100%;
    min-height: 0;
}

.packet-window-body-scroll {
    flex-grow: 1;
    min-height: 0;
}

.packet-window-footer {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: var(--space-3);
}

.packet-window-footer-action {
    flex-grow: 1;
    flex-basis: 0;
}

.packet-window-footer-action--spaced {
    margin-left: var(--space-2);
}

/* Двойной селектор: .packet-window-action объявлен ниже и при равной
   специфичности перебил бы одиночный .packet-window-exit. */
.packet-window-action.packet-window-exit {
    background-color: var(--state-danger-wash);
    border-color: var(--border-danger);
    color: var(--state-danger);
}

.packet-window-action.packet-window-exit:hover {
    background-color: var(--state-danger-glow);
    border-color: var(--border-danger);
    color: var(--text-primary);
}

/* Белый крестик закрытия в правом верхнем углу окна. Заменяет футерную
   кнопку «ВЫЙТИ»: клик уходит на сервер как обычный ElementClickPacket.
   Крестик собран из двух повёрнутых полосок — вид не зависит от глифов
   шрифта. */
.packet-window-close {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 22px;
    height: 22px;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--radius-sm);
    background-color: transparent;
}

.packet-window-close:hover {
    background-color: var(--state-danger-wash);
}

.packet-window-close:active {
    background-color: var(--state-danger-glow);
}

.packet-window-close-bar {
    position: absolute;
    left: 5px;
    top: 10px;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background-color: var(--light-solid);
}

.packet-window-close-bar--a {
    rotate: 45deg;
}

.packet-window-close-bar--b {
    rotate: -45deg;
}

/* Кнопка действия — приём главного меню (mm-btn-outline): прозрачная,
   тонкая рамка, при наведении светлеет. Нижние кнопки окна («Продать всё»,
   «Продать») и кнопки списков выглядят как кнопки меню, а не дефолтные
   боксы Unity. */
.packet-window-action {
    min-height: 36px;
    padding: var(--space-3) var(--space-8);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sharp);
    color: var(--text-primary);
    -unity-font-definition: var(--face-body);
    font-size: var(--size-base);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.packet-window-action:hover {
    background-color: var(--light-film);
    border-color: var(--light-solid);
    color: var(--light-solid);
}

/* Ряд нижних кнопок окна (мост помечает контейнер PacketUI.Buttons):
   центрирован, кнопки по ширине текста с общим минимумом — приём
   нижней пары «Продать всё / Продать» из legacy-клиента. */
.packet-window-actions-row {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--space-4);
}

.packet-window-actions-row .packet-window-action {
    flex-grow: 0;
    min-width: 168px;
    margin: 0 var(--space-2);
}

/* Вкладки легаси-окна — горизонтальный ряд «язычков» в приёме навигации
   меню (mm-nav-tab), положенном на бок: прозрачная кнопка с полосой 3px
   снизу; активная вкладка — это Label без действия с бирюзовой полосой.
   Правила идут после .packet-window-action и на тех же элементах
   переопределяют его — вкладка не должна выглядеть кнопкой. */
.packet-window-tab {
    min-width: 64px;
    /* Высота фиксированная, а не минимальная: разметка в ярлыке (цветной
       спан «Топ по <color=white>уровню</color>») меняет метрики строки,
       и вкладка «распухала», съезжая относительно соседних. */
    height: 30px;
    overflow: hidden;
    margin: 0 var(--space-2) 0 0;
    padding: var(--space-2) var(--space-6);
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    border-radius: 0;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
}

.packet-window-tab:hover {
    background-color: var(--accent-cyan-tint);
    border-bottom-color: transparent;
    color: var(--light-solid);
}

/* Активная вкладка: текст без действия, геометрия как у таб-кнопок. */
.packet-window-tab-active {
    height: 30px;
    overflow: hidden;
    margin-right: var(--space-2);
    padding: var(--space-2) var(--space-6);
    background-color: var(--accent-cyan-wash);
    border-bottom-width: 3px;
    border-bottom-color: var(--accent-cyan);
    border-radius: 0;
    color: var(--accent-cyan);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.packet-window-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.packet-window-row-label {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.packet-window-row > .packet-window-action {
    min-width: 112px;
    margin-left: 8px;
}

/* Строка ввода richlist из моста (PacketUI.FormRow*): подпись тянется,
   инпут прижат вправо фиксированной шириной — приём legacy-клиента. */
.packet-window-form-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.packet-window-form-row-label {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.packet-window-form-row-input {
    width: 220px;
    flex-shrink: 0;
    margin-left: 8px;
}

/* Кнопки канваса из моста (PacketUI.CanvasButton): размер и позицию задаёт
   сервер через Canvas.X/Y/Width/Height, поэтому фикс-минимум и крупные
   отступы .packet-window-action сброшены — бокс обязан совпасть с сеткой
   координат автора канваса. MicroButton (Canvas.Micro) мельче шрифтом. */
.packet-window-action--canvas {
    min-height: 0;
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    font-size: var(--size-sm);
    overflow: hidden;
}

.packet-window-action--canvas.packet-window-action--micro {
    font-size: var(--size-2xs);
    padding: 0 var(--space-2);
}

/* Строка слайдера из моста: [иконка][остаток]──дорожка──[выбрано][цена],
   как в legacy-клиенте: числа прижаты к краям своих колонок, дорожка
   тянется только между ними. Иконка — ImagePacket из пакета. */
.packet-window-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

/* Дорожка тянется на всё свободное место между числами и ценой. */
.packet-window-slider-row .packet-slider {
    width: auto;
    flex-grow: 1;
    margin: 0 var(--space-2);
}

.packet-window-slider-row-lead,
.packet-window-slider-row-suffix {
    flex-shrink: 0;
    color: var(--text-primary);
    font-size: var(--size-base);
}

/* Числа: остаток прижат вправо, к началу дорожки; иконка кристалла —
   перед ним (ей хватает собственного инлайн-размера из пакета). */
.packet-window-slider-row-lead {
    min-width: 44px;
    -unity-text-align: middle-right;
    margin-right: var(--space-2);
}

/* Иконка кристалла — картинка-лид: размер приходит из пакета (14×14) и
   колонкой чисел не является, поэтому без min-width — иначе фон
   растягивается по X. */
.packet-window-slider-row-lead-icon {
    flex-shrink: 0;
    margin-right: var(--space-2);
}

/* Выбранное количество — у конца дорожки. */
.packet-window-slider-row-suffix {
    min-width: 40px;
    -unity-text-align: middle-left;
    margin-left: var(--space-2);
}

/* Цена — отдельная колонка правее числа (как «Цена» legacy), метку
   PacketUI.PriceColumn ставит мост. */
.packet-window-slider-row-price {
    min-width: 56px;
    -unity-text-align: middle-right;
    margin-left: var(--space-4);
    color: var(--accent-cyan);
}

/* Сетка карточек инвентаря легаси-окон (метка PacketUI.InventoryCard на
   TextPacket из моста): перенос GridLayoutGroup старого клиента —
   ряды режет ширина окна, ячейки не сжимаются. */
.packet-inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-3);
}

/* Карточка-кнопка: иконка предмета сверху, статус цен прижат к дну —
   раскладка legacy-клетки. Высоту ячейки присылает сервер инлайном
   (inv-ch: у маркета 95 — воздух между иконкой 44 и статусом опускает
   цены вниз). Ширина 60 с шагом 64 даёт 10 карточек в ряду окна 680 —
   ~48 предметов умещаются в 5 рядов на странице. */
.packet-inventory-card {
    width: 60px;
    min-width: 60px;
    flex-shrink: 0;
    flex-grow: 0;
    justify-content: flex-start;
    align-items: center;
    margin: var(--space-1);
    padding: var(--space-2) 0;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sharp);
    color: var(--text-primary);
    -unity-font-definition: var(--face-body);
}

.packet-inventory-card:hover {
    background-color: var(--light-film);
    border-color: var(--light-solid);
}

.packet-inventory-card:active {
    background-color: var(--accent-cyan-tint);
}

.packet-inventory-card__icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Faint-слот (не хватает предметов): приглушённая иконка старого клиента. */
.packet-inventory-card__icon--faint {
    opacity: 0.4;
}

/* Блок статуса прижат к дну клетки: иконка сверху, цены снизу — раскладка
   legacy-клетки. Блок растёт на свободное место между иконкой и низом. */
.packet-inventory-card__status {
    flex-grow: 1;
    flex-shrink: 0;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
}

/* Строка статуса: «Распродано», «Нет спроса» и цены целиком. Шрифт 8px —
   размер legacy (size=8): «Распродано» (~52px) гарантированно влезает в
   58px внутренней ширины клетки при любых метриках шрифта. Строки сжаты
   друг к другу (2px). Многоточие — страховка от строки длиннее клетки.
   Цвет строки задаёт сервер legacy-тегом (клиент красит Label). */
.packet-inventory-card__label {
    font-size: 8px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 100%;
    margin-top: var(--space-1);
}

/* Рамка выбранного слота UP (метка PacketUI.SlotSelection): пустой бортик
   вокруг ячейки 38×38 — арт иконки не перекрывает, клики проходят мимо
   (pickingMode Ignore в билдере). Цвет выделения — как у выбранного слота
   инвентаря. */
.packet-slot-selection {
    border-width: 2px;
    border-color: var(--accent-gold);
    border-radius: var(--radius-sm);
}

.packet-scrollbar {
    background-color: var(--surface-shelf-solid);
}

.packet-scrollbar--vertical {
    width: 12px;
    border-left-width: 1px;
    border-left-color: var(--border-subtle);
}

.packet-scrollbar--horizontal {
    height: 12px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.packet-scrollbar .unity-slider__tracker {
    background-color: var(--surface-raised);
}

.packet-scrollbar .unity-slider__dragger {
    background-color: var(--border-cyan);
    border-color: var(--border-cyan);
}

.packet-scrollbar .unity-repeat-button {
    background-color: var(--surface-raised);
    color: var(--text-primary);
}

.packet-line-themed {
    color: var(--border-cyan);
}

/* Страница без прокрутки (мост: PacketUI.FixedPage на UP-окне). Уплотнять
   контент не нужно: под UP мост выделяет высокое окно (560px), всё влезает
   в натуральных размерах — вид робота 397x260, карточка умения, кнопки. */

/* Карточка описания умения на UP-странице (мост: PacketUI.LeadIcon):
   иконка слева в нативном размере арта, текст занимает всю оставшуюся
   ширину и прижат влево — пространства под текст больше, чем у прежней
   центральной подписи. */
.packet-window-lead-card {
    flex-direction: row;
    /* Иконка центрируется по высоте карточки: текст описания выше иконки,
       и выравнивание по верхнему краю уводило иконку вверх (репорт:
       «сдвинь текстурку ниже, чтобы было отцентровано с текстом»). */
    align-items: center;
    margin: var(--space-2) 0 0;
}

.packet-window-lead-card__icon {
    width: 75px;
    height: 75px;
    flex-shrink: 0;
    margin-right: var(--space-3);
}

.packet-window-lead-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    -unity-text-align: upper-left;
    color: var(--text-primary);
}

/* Плашка уровня над слотом UP-канваса (мост: PacketUI.LevelPill; цвет фона
   приходит attached-свойством и красит лейбл в билдере) — перенос
   levelImage/levelTF старого клиента: узкий скруглённый прямоугольник
   цвета навыка (26x13), тёмные цифры, центр на верхней кромке кольца. */
.packet-level-pill {
    border-radius: 2px;
    color: #101010;
    font-size: var(--size-2xs);
    -unity-font-style: bold;
}

/* Счётчик предметов (однострочный статус клетки) — бейдж в правом нижнем
   углу, как в старом клиенте; цены ордеров (несколько строк) остаются
   центрированной стопкой в блоке статуса. */
.packet-inventory-card__amount {
    font-size: 8px;
    color: var(--text-primary);
    -unity-text-align: middle-right;
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    align-self: flex-end;
}
